APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Path (relative to public/) of the brand logo used for favicons, meta images and in-app logos
APP_LOGO=images/logo/dielar.png

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared key for /api/v1/partner/* — the server-to-server endpoints the
# Deilar marketing site reads member data from. Must match IBUSINESS_API_KEY
# in that app. Leaving it blank closes those endpoints rather than opening
# them. Generate with: php -r "echo bin2hex(random_bytes(32));"
PARTNER_API_KEY=

# The Deilar marketing site. It is where the QR code printed on a member card
# sends whoever scans it: {DEILAR_URL}/membership/{slug}. Leave blank and the
# code falls back to this application's own /membership page, so cards
# generated on an install with no marketing site still resolve.
DEILAR_URL=http://127.0.0.1:8000

# Google Gemini, used by every admin AI helper: "Generate SEO with AI" on the
# facility and product forms, the list-wide "Fill SEO with AI" sweeps, and the
# "Fix English with AI" tools. Leave blank to disable them — nothing else
# depends on it. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ABS Courier & Freight Systems — the courier the admin hands an order to from
# /admin/order/{code} ("Ship with ABS"). Leave ABS_API_KEY blank and the button
# never appears; nothing else depends on it. Docs: https://docs.absegy.com
#
# ABS_BASE_URL defaults to the STAGING server. Point it at
# https://core.absegy.com only when you mean to book real couriers.
ABS_API_KEY=
ABS_BASE_URL=https://dev.core.absegy.com
# Optional with an API key — the key already names its sub-account.
ABS_SUB_ACCOUNT_ID=
# The warehouse the parcel is collected from. Set it and the pickup is booked
# by the same call that creates the shipment (status AWAITING_PICKUP); leave it
# blank and the shipment starts as NEW with no pickup arranged.
ABS_LOCATION_ID=
# Optional ABS service/product id — drives their fee calculation.
ABS_PRODUCT_ID=

# The SMS gateway behind the storefront's phone login — Advance Messaging
# Systems' GWE2S HTTP API (see "API GWE2S Secure"). One GET per message.
#
# Leave the credentials blank and SMS delivery is simply OFF: the login falls
# back to the fixed code below, which is the right state for a local install.
# Nothing else in this application sends SMS, so nothing else breaks.
#
# Authenticate with EITHER SMS_API_USER + SMS_API_PASSWORD, or the single
# SMS_API_ACCESS_KEY the gateway can issue instead — the access key wins when
# both are set. SMS_API_SENDER is the sender id printed as the message's
# origin, and must be one the gateway has registered for this account: an
# unregistered one is refused with "ERROR - HTTP06".
SMS_API_URL=https://gwe2s.broadnet.me:8443/websmpp/websms
SMS_API_USER=
SMS_API_PASSWORD=
SMS_API_ACCESS_KEY=
SMS_API_SENDER=
# Prefixed to every destination number before sending: members are stored as
# 01xxxxxxxxx and the gateway wants 201xxxxxxxxx.
SMS_API_COUNTRY_CODE=20
SMS_API_TIMEOUT=15
# The gateway is served over a non-standard port with a chain some hosts do not
# carry. Only set this to false if you know why you are doing it.
SMS_API_VERIFY_SSL=true

# NOTE: the OTP itself is NOT configured here. How the storefront's phone login
# behaves is edited in the admin at /admin/setting, because an administrator is
# expected to change it without a deploy — see App\Support\OtpSettings:
#
#   otp_sms_enabled   send a real random code by SMS, or don't. Turn this OFF
#                     to stop sending and use the fixed code below. It is
#                     forced off anyway while the credentials above are blank.
#   otp_fixed_code    the code that verifies while SMS is off (seeded as 1234).
#                     Refused whenever SMS is on, so leaving it set is not a
#                     permanent way past a real code. Clearing it with SMS also
#                     off closes the login entirely.
#   otp_length        digits in a generated code (4-8, seeded as 4)
#   otp_ttl_minutes   how long a code is good for (1-60, seeded as 10)
#   otp_message       the SMS body; ":code" and ":app" are filled in
#
# Run `php artisan db:seed --class=SettingSeeder` to create those rows on an
# install that predates them. It never overwrites a row that already exists.
